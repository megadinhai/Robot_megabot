# Google Gemini API Key (Bắt buộc thiết lập trong Secret trên Hugging Face Spaces hoặc file .env local)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_STT_MODEL=gemini-3.1-flash-lite-preview

# OpenAI (ChatGPT) API Key
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Giọng đọc tiếng Việt Edge-TTS mặc định (vi-VN-HoaiMyNeural hoặc vi-VN-NamMinhNeural)
TTS_VOICE=vi-VN-HoaiMyNeural

# Server Configuration (Hugging Face Spaces bắt buộc chạy port 7860, local chạy 8000)
HOST=0.0.0.0
PORT=8000
