# Google Gemini API Key (Bắt buộc thiết lập trong Secret trên Hugging Face Spaces hoặc file .env local)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini (Khuyên dùng: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Giọng đọc tiếng Việt Edge-TTS mặc định (vi-VN-HoaiMyNeural hoặc vi-VN-NamMinhNeural)
TTS_VOICE=vi-VN-HoaiMyNeural

# Server Configuration (Hugging Face Spaces bắt buộc chạy port 7860)
HOST=0.0.0.0
PORT=7860
